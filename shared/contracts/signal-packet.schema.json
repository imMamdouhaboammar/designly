{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DesignSignalPacket",
  "type": "object",
  "required": [
    "packet_id",
    "from",
    "to",
    "job",
    "decisions",
    "evidence",
    "confidence",
    "hard_vetoes",
    "soft_warnings",
    "unresolved",
    "recommended_next"
  ],
  "properties": {
    "packet_id": {
      "type": "string",
      "pattern": "^PKT-[0-9A-Za-z_-]+$"
    },
    "from": {
      "type": "string",
      "enum": [
        "designly_director",
        "strategy_planner",
        "brand_guardian",
        "taste_analyst",
        "structure_critic",
        "craft_director",
        "arabic_visual_director",
        "visual_reviewer",
        "designly-director",
        "creative-strategy",
        "brand-intelligence",
        "taste-engine",
        "reference-memory",
        "composition-director",
        "typography-director",
        "photography-director",
        "manipulation-director",
        "arabic-rtl-director",
        "campaign-dna",
        "prompt-compiler",
        "visual-qa"
      ]
    },
    "to": {
      "type": "string",
      "enum": [
        "designly_director",
        "strategy_planner",
        "brand_guardian",
        "taste_analyst",
        "structure_critic",
        "craft_director",
        "arabic_visual_director",
        "visual_reviewer",
        "designly-director",
        "creative-strategy",
        "brand-intelligence",
        "taste-engine",
        "reference-memory",
        "composition-director",
        "typography-director",
        "photography-director",
        "manipulation-director",
        "arabic-rtl-director",
        "campaign-dna",
        "prompt-compiler",
        "visual-qa"
      ]
    },
    "job": {
      "type": "string"
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "value"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "value": {},
          "rationale": {
            "type": "string"
          },
          "priority": {
            "type": "integer",
            "minimum": 1,
            "maximum": 11
          }
        },
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Evidence strength: 1.00 explicit/brand lock, 0.75-0.90 observed brand, 0.55-0.80 single reference, 0.40-0.70 inferred design"
    },
    "hard_vetoes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rule",
          "reason",
          "severity"
        ],
        "properties": {
          "rule": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "hard_gate"
            ]
          },
          "remediation": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "soft_warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommended_next": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
